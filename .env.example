# =============================================
# API 키 설정 — 이 파일을 복사해 .env로 만드세요
# cp .env.example .env
# =============================================

# 로컬 기본: openai-oauth 프록시
LLM_PROVIDER=openai_oauth
LLM_BASE_URL=http://127.0.0.1:10532/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.6-sol
LLM_MAX_TOKENS=8000
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECS=120

ANALYSIS_COOLDOWN_SECS=0
ANALYSIS_DEBOUNCE_SECS=5
PREVENT_CONCURRENT_ANALYSIS=true

# Optional: OpenAI 종량제 API를 직접 사용할 때
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your_dummy_key
# LLM_MODEL=gpt-4.1-mini

# Optional: OpenAI-compatible provider를 사용할 때
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=your_dummy_key
# LLM_MODEL=your-chat-model

# Optional: Claude/Anthropic을 사용할 때
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your_dummy_key
# ANTHROPIC_MODEL=claude-sonnet-4-6

# 선택: 계좌 조회용. 분석 전용이면 read-only 권한만 권장합니다.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Bitcoin Trading Manager V2
ENGINE_V2_ENABLED=true
LEGACY_ENGINE_ENABLED=false
LEGACY_DEBATE_ENABLED=false
DEBATE_ENABLED=false
MEMORY_ENABLED=false
AGENT_MEMORY_WRITE_ENABLED=false
ENGINE_V2_SHADOW_MODE=true
V2_MODE=live
V2_LIVE_ENABLED=true
V2_ACCOUNT_ENABLED=true
V2_LIVE_LIMIT=120
V2_SHADOW_INTERVAL_SECONDS=300
V2_STORAGE_BACKEND=duckdb
V2_DUCKDB_PATH=data/v2/engine.duckdb
V2_PARQUET_ROOT=data/v2/raw
V2_DATA_DIR=data/v2
V2_RETENTION_DAYS=90
V2_MIN_DATA_QUALITY=partial
V2_MIN_NET_EDGE_BPS=8
V2_MAX_DATA_AGE_SECONDS=900
V2_MAX_FACTOR_EXPOSURE=2.5
V2_MAX_EVENT_RISK=0.8
V2_MAX_CORRELATED_POSITIONS=2
V2_REQUEST_TIMEOUT_SECONDS=8
V2_MAX_RETRIES=2

# Optional read-only market providers
COINGLASS_API_KEY=
COINGLASS_ENABLED=false
COINGLASS_REQUEST_BUDGET=
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT=
KIS_ENABLED=false
GATE_READ_ONLY=true
BINANCE_ENABLED=true
BYBIT_ENABLED=true
DERIBIT_ENABLED=true
GATE_STOCK_ENABLED=false
GATE_CFD_ENABLED=false
SAVE_TICKER_MANUAL_INTAKE_ENABLED=true
# Public deployments must set a strong random token; without it intake is localhost-only.
SAVE_TICKER_INTAKE_TOKEN=
